# VITE_ variables are inlined into the client bundle at build time and are
# publicly readable — never put a secret, token, or API key here.

# "mock" runs entirely on in-memory fixtures with no network calls.
# Unset (or anything else) uses the real API and excludes mock/ from the build.
VITE_API_MODE=mock

# Base path the frontend calls for API requests.
VITE_API_BASE=/api
