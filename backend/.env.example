# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Database roles (PostgreSQL 16)
DATABASE_URL_APP=postgresql://lg_app:changeme_app@localhost:5432/leadguard
DATABASE_URL_WORKER=postgresql://lg_worker:changeme_worker@localhost:5432/leadguard
DATABASE_URL_MIGRATOR=postgresql://lg_migrator:changeme_migrator@localhost:5432/leadguard

# Secrets (>= 32 chars)
APP_SECRET=change-this-to-at-least-32-random-characters-in-prod
APP_SECRET_KEY_VERSION=1
# APP_SECRET_PREVIOUS=previous-secret-for-rotation

# Sessions
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_DAYS=30
COOKIE_NAME=__Host-sid
REAUTH_WINDOW_MINUTES=10

# Limits
RATE_GLOBAL_PER_MIN=300
RATE_USER_PER_MIN=120
SSE_MAX_PER_USER=3
SSE_MAX_PER_WORKSPACE=100
BODY_LIMIT_KB=100

# Demo seed passwords (never hard-code in source)
DEMO_OWNER_PASSWORD=OwnerPass2024!
DEMO_USER_PASSWORD=UserPass2024!

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Stripe (use restricted key in production)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:AAxxxxxxxxxxxxxxxxxxxxxx

# Google Calendar
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
