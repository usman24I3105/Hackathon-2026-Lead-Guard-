{
  "name": "leadguard-backend",
  "version": "1.0.0",
  "description": "LeadGuard backend monolith — Express + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:demo": "tsx src/db/seed-demo.ts",
    "seed:big": "tsx src/db/seed-demo.ts --big",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "backfill:history": "tsx src/db/backfill-history.ts"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "googleapis": "^186.0.0",
    "helmet": "^7.2.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "stripe": "^17.4.0",
    "twilio": "^5.3.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
